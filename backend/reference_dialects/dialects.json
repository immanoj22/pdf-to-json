  "contextual_units": {
   "title": {
    "parent_in": "sectioning",
    "or_via": [
     "info"
    ],
    "note": "A title is a heading only for a sectioning element or its info; elsewhere (bibliography, citation, table) it is part of the enclosing entry."
   },
   "subtitle": {
    "parent_in": "sectioning",
    "or_via": [
     "info"
    ]
   }
  }
 },
 "dialects": [
  {
   "name": "dtbook",
   "detect": {
    "root_namespace_contains": [
     "daisy.org/z3986"
    ],
    "root_names": [
     "dtbook"
    ],
    "contains_elements": [
     "pagenum"
    ]
   },
   "page_marker_elements": [
    "pagenum"
   ]
  },
  {
   "name": "docbook",
   "detect": {
    "root_namespace_contains": [
     "docbook.org"
    ]
   },
   "page_marker_elements": []
  },
  {
   "name": "docbook4-page-anchors",
   "note": "DocBook 4 without namespace whose page breaks are empty anchors with ids page<label> (book 4). Every anchor is read as a page marker; the frozen reader takes no label from it, so the gold writer reads the label from the id with page_marker_label (evaluation data).",
   "detect": {
    "root_names": [
     "book"
    ]
   },
   "page_marker_elements": [
    "anchor"
   ],
   "page_marker_label": {
    "attribute": "id",
    "pattern": "^page(.+)$"
   }
  },
  {
   "name": "docbook-like-fragments",
   "detect": {
    "fallback": true
   },
   "page_marker_elements": []
  }
 ]
}
