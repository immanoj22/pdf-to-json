              "slots": {
                "main": {
                  "contentmodel": "proofread-page",
                  "contentformat": "text/x-wiki",
                  "content": "<noinclude><pagequality level=\"3\" user=\"محمد قيس كاظم\" />{{ترقيم|صوت الشاعر||٢٣2}}</noinclude>الانسان واقول ايضاً: ان كان بقائي يوجب فناء سواي\nفالموت اذن الذ لديَّ واحب، و ان لم اجد من يقتلني شريفاً\nومحباً منزهاً تمتعت بتقديم ذاتي بيدي الى الابدية قبل اوان\nالابدية\n\nالانانية يا اخي اوجدت التنافس الاعمى، والتنافس\nولد العصبية، والعصبية وضعت السلطة وكانت هذه داعياً\nللمنازعات والاستعباد. النفس تقول بسلطة الحكمة والعدالة\nعلى الجهالة والظلم، لكنها تنكر تلك السلطة التي تستل من\nالمعادن قواضب وبواتر لتعميم الجهالة والمظالم. تلك السلطة\nالتي هدمت بابل وقوضت ارکان اورشليم ودكت مباني\nرومية. تلك التي اوجدت سفاكي الدمـاء والقتلة الذين\nينعتهم الناس بالعظماء والكتاب تجل اسماءهم والكتب لا\nتأبى حفظ معاركهم سيف بطونها كما ان الارض لم تأبَ\nحملهم على ظهرها حينما كانوا يخضبون محياها بالدماء<noinclude><references/></noinclude>"
                }
              }
            }
          ]
        }
      ]
    }
  },
