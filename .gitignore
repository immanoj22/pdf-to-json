# Environments, generated caches and bytecode at any depth.
.venv/
.venv-*/
.cache/
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]
*.egg-info/
build/
dist/
# Frontend dependencies and machine-local upload/conversion data.
node_modules/
frontend_temp/runtime/
frontend_temp/*.log
frontend_temp/*.pid
frontend_temp/*_results.json
frontend_temp/protected_before.json
# Per-page evidence is rebuildable, not committed.
experiments/out/step2/page_cache/
# Model weights and download caches.
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx
*.gguf
pytorch_model*.bin
models/
weights/
# Oversized unseen-page fixtures are recreated from the Step 4a-v manifest
# (experiments/recreate_unseen_fixtures.py verifies source and fixture SHA-256).
experiments/fixtures_unseen/u11_spanish_fullpage_map.pdf
# Machine-local configuration (for example private file names discovery must skip).
*.local.txt
*.local.toml

# Step 6b transient pytest source-copy fixtures.
experiments/out/step6b/tmp_*/
experiments/out/step6b/**/*.tmp

# Step 17b isolated pytest workspaces; retain audit logs/receipts separately.
.s17bt/
experiments/out/step17b/test_runs/
experiments/out/step17b/final/packaging/*.whl
