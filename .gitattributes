* text=auto eol=lf
# Gold fixtures are immutable reference bytes: never convert line endings.
backend/tests/gold/** -text
# Derived gold is verified by SHA-256 of its exact bytes: never convert line endings.
backend/tests/gold_derived/** -text
# Step 11d frozen evidence and executed source snapshots retain exact recorded bytes.
experiments/out/step11d/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Step 11e measurements retain the exact bytes covered by their evidence manifest.
experiments/out/step11e/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Step 11d continuation measurements retain their exact recorded bytes (including UTF-16 logs).
experiments/out/step11d2/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Step 17 receipts and source downloads are covered by exact-byte checksums.
experiments/out/step17/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve downloaded ground truth and HTML verbatim, including upstream whitespace.
experiments/test_data/step17_real_scans/** -text -whitespace
